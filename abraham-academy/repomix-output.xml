  const { slug } = await params;
  const post = blogPosts.find((p) => p.slug === slug);

  if (!post) {
    notFound();
  }

  const whatsappUrl =
    "https://wa.me/923149500765?text=" +
    encodeURIComponent(`Hi! I read your article "${post.title}" and would like to ask about a Free Trial Class.`);

